---
import Layout from '../layouts/Layout.astro';
import styles from './contact/contact.module.css';
---

<Layout title="Contact Us | Sahajanand Digital" description="Contact Sahajanand Digital for all your IT requirements including Web Design, IT Consultancy, Digital Marketing, and Mobile App Development.">
  <div class="section pb-0">
    <div class="container">
      <div class="text-center mb-12">
        <h1 class="mb-6">Contact Us</h1>
        <p class="text-lg max-w-3xl mx-auto mb-10">
          Have a project in mind? We'd love to hear from you. Fill out the form below and our team will get back to you within 24 hours.
        </p>
        
        <div class={styles.infoSummary}>
          <div class={styles.infoItem}>
            <strong>Mail</strong>
            <span>hello@sahajananddigital.in</span>
          </div>
          <div class={styles.infoItem}>
            <strong>Support Email</strong>
            <span>tickets@sahajanand-digital-main.p.tawk.email</span>
          </div>
          <div class={styles.infoItem}>
            <strong>Whatsapp Phone</strong>
            <span><a href="https://wa.me/918160535181" target="_blank" rel="noopener noreferrer">+91 8160535181</a></span>
          </div>
          <div class={styles.infoItem}>
            <strong>Location</strong>
            <span> 505, Blueberry Complex, Opp. Ganesh Rivera, Nr.Gurukul Circle, Nikol, Ahmedabad, Gujarat, India - 382350</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class={styles.fullWidthForm}>
    <iframe 
      src="https://docs.google.com/forms/d/e/1FAIpQLSdDe71TIdlE_xyn2MsgdcRVHPuIbhCus98BguE-tNP9uvpi2w/viewform?embedded=true" 
      width="100%" 
      height="1000" 
      frameborder="0" 
      marginheight="0" 
      marginwidth="0"
      title="Contact Form"
      class={styles.iframe}
    >
      Loading…
    </iframe>
  </div>
</Layout>
